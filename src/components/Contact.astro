---
import { site } from '../data/site';
import { hasCv } from '../lib/site-files';
const links = [
  site.linkedin && { label: 'LinkedIn', href: site.linkedin },
  site.github && { label: 'GitHub', href: site.github },
].filter(Boolean) as { label: string; href: string }[];
---
<section id="contact" class="section container" aria-labelledby="contact-title">
  <div class="box">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title">Hiring for GenAI or backend? <span class="serif grad-text">I'd like to talk.</span></h2>
    <p class="sub">{site.availability} · {site.location}</p>
    <div class="row">
      {site.email && <a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a>}
      {hasCv && <a class="btn btn-ghost" href={site.cvPath} download>Download CV</a>}
      {links.map((l) => <a class="btn btn-ghost" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
    </div>
    {site.email && <p class="addr">or write to <span class="mono">{site.email}</span></p>}
  </div>
</section>

<style>
  .box {
    position: relative; overflow: hidden; padding: clamp(32px, 6vw, 64px); border-radius: 24px; border: 1px solid var(--ln);
    background: radial-gradient(80% 120% at 100% 0%, rgba(255, 94, 126, 0.16), transparent 60%), radial-gradient(60% 100% at 0% 100%, rgba(255, 162, 74, 0.12), transparent 60%), var(--s1);
  }
  h2 { margin: 0 0 14px; max-width: 18ch; font-weight: 600; font-size: clamp(32px, 4.6vw, 58px); line-height: 1.02; letter-spacing: -0.045em; text-wrap: balance; }
  .sub { margin: 0 0 28px; color: var(--mu); }
  .row { display: flex; flex-wrap: wrap; gap: 12px; }
  .row:empty { display: none; }
  .addr { margin: 18px 0 0; color: var(--dim); font-size: 14px; }
  .addr .mono { color: var(--mu); user-select: all; }
</style>
