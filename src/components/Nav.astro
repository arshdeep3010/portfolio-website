---
import { site } from '../data/site';
import { hasCv } from '../lib/site-files';

interface Props { onHome?: boolean }
const { onHome = true } = Astro.props;
const to = (hash: string) => (onHome ? hash : `/${hash}`);
---
<header class="nav">
  <div class="container nav-in">
    <a class="brand" href="/" aria-label={`${site.name}, home`}><span class="logo" aria-hidden="true">AS</span>{site.name}</a>
    <nav aria-label="Main" class="links">
      <a href={to('#work')}>Work</a>
      <a href={to('#how')}>How I build</a>
      <a href={to('#about')}>About</a>
      <a href={to('#contact')}>Contact</a>
    </nav>
    <div class="actions">
      {site.github && <a class="plain" href={site.github} target="_blank" rel="noopener">GitHub</a>}
      {hasCv
        ? <a class="btn btn-primary sm" href={site.cvPath} download>Download CV</a>
        : <a class="btn btn-primary sm" href={to('#contact')}>Get in touch</a>}
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    background: rgba(9, 9, 11, 0.72);
    -webkit-backdrop-filter: saturate(140%) blur(14px); backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--ln);
  }
  .nav-in { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; letter-spacing: -0.01em; text-decoration: none; white-space: nowrap; }
  .logo {
    width: 26px; height: 26px; border-radius: 7px; display: grid; place-items: center;
    background: linear-gradient(135deg, var(--g1), var(--g2)); color: #1a0a06; font: 600 11px var(--f-mono);
  }
  .links { display: flex; gap: 28px; font-size: 14px; }
  .links a, .plain { color: var(--mu); text-decoration: none; transition: color 0.2s; }
  .links a:hover, .plain:hover { color: var(--tx); }
  .actions { display: flex; align-items: center; gap: 18px; font-size: 14px; }
  .sm { padding: 8px 14px; font-size: 14px; border-radius: 9px; }
  @media (max-width: 820px) {
    .links { display: none; }
    .plain { display: none; }
  }
</style>
