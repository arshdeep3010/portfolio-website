---
// Small live demos shown inside project cards. Each one is an illustration of
// what the project does; all of them are driven by the script at the bottom.
interface Props { type: 'chaos' | 'fit' | 'health' | 'vibe' | 'gateway' | 'none'; image?: string; title: string }
const { type, image = '', title } = Astro.props;

const fitRows: [string, 'yes' | 'no'][] = [
  ['Python + FastAPI services', 'yes'],
  ['RAG with a vector store', 'yes'],
  ['LangGraph agents', 'yes'],
  ['Kubernetes in production', 'no'],
];
const code = [
  ['const express = require("express")', -1],
  ['const app = express()', -1],
  ['const KEY = "sk_live_••••••••"', 2],
  ['app.get("/user", (req, res) => {', -1],
  ['  const q = "SELECT * FROM users WHERE id=" + req.query.id', 4],
  ['  db.query(q, (e, rows) => res.json(rows))', -1],
  ['})', -1],
  ['app.post("/login", login)', 7],
  ['app.listen(3000)', -1],
] as const;
---
{type === 'chaos' && (
  <div class="demo" data-demo="chaos" role="img" aria-label="Illustration: 500 runs filling up while workers are killed; lost runs stay at 0.">
    <span class="lbl">chaos test</span>
    <div class="cgrid">{Array.from({ length: 500 }, () => <i></i>)}</div>
    <div class="cmeter"><span>runs <b data-d="runs">500</b>/500</span><span>workers killed <b data-d="kills">435</b></span><span class="z">lost <b>0</b></span></div>
  </div>
)}
{type === 'fit' && (
  <div class="demo" data-demo="fit" role="img" aria-label="Illustration: job requirements checked one by one; three verified with cited code, one unverified.">
    <span class="lbl">job description check</span>
    <div class="frows">
      {fitRows.map(([r, v]) => (
        <div class="frow on" data-r={v}><span>{r}</span><span class={`v ${v}`}>{v === 'yes' ? 'verified · cited code' : 'unverified · no code'}</span></div>
      ))}
    </div>
  </div>
)}
{type === 'health' && (
  <div class="demo" data-demo="health" role="img" aria-label="Illustration: claims pass through 7 rules; the AI is consulted only when the rules allow.">
    <span class="lbl">claim decision</span>
    <div class="hpipe"><div class="hnode on">Claim</div><div class="hnode on">7 rules</div><div class="hnode on">AI check</div><div class="hnode on">Decision</div></div>
    <span class="hdot"></span>
    <div class="hout"><span class="dec approve">APPROVE</span><span class="why">rules allow, AI agrees</span></div>
  </div>
)}
{type === 'vibe' && (
  <div class="demo" data-demo="vibe" role="img" aria-label="Illustration: a scan finds a hardcoded secret, SQL built from user input and a login with no rate limit.">
    <span class="lbl">scan</span>
    <div class="vcode">{code.map(([l, n]) => <div class:list={['ln', { hl: n >= 0 }]}>{l}</div>)}</div>
    <span class="vscan"></span>
    <div class="vfind">
      <div class="hi on" data-f="2"><b>HIGH</b>hardcoded secret · line 3</div>
      <div class="hi on" data-f="4"><b>HIGH</b>SQL from user input · line 5</div>
      <div class="md on" data-f="7"><b>MEDIUM</b>no rate limit on login · line 8</div>
    </div>
    <span class="vgrade">grade<b>F</b></span>
  </div>
)}
{type === 'gateway' && (
  <div class="demo" data-demo="gateway" role="img" aria-label="Illustration: a request goes through the gateway. When the first provider fails, the backup provider answers, and no request is lost.">
    <span class="lbl">provider outage</span>
    <div class="gpipe">
      <div class="gnode on">App</div>
      <div class="gnode on">Gateway</div>
      <div class="gprov">
        <div class="gnode skip" data-p="0">Provider 1<small>circuit open</small></div>
        <div class="gnode ok" data-p="1">Provider 2<small>answered</small></div>
      </div>
    </div>
    <div class="gout"><span class="gstate">provider 1 skipped, no time wasted</span><span class="gcount"><b>20,000</b> / 20,000</span></div>
  </div>
)}
{type === 'none' && (
  <div class="demo shot">
    {image && <img src={image} alt={'Screenshot of ' + title} loading="lazy" decoding="async" />}
    {!image && <span>Screenshot or 6-second loop</span>}
  </div>
)}

<style>
  .demo { position: relative; height: 196px; border-radius: 12px; background: #0c0c0f; border: 1px solid var(--ln); overflow: hidden; font: 12px var(--f-mono); color: var(--mu); }
  .lbl { position: absolute; right: 10px; top: 8px; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--dim); }
  .shot { display: grid; place-items: center; background: repeating-linear-gradient(135deg, #0c0c0f 0 12px, #101014 12px 24px); }
  .shot img { width: 100%; height: 100%; object-fit: cover; }

  .cgrid { position: absolute; left: 14px; top: 30px; display: grid; grid-template-columns: repeat(25, 8px); gap: 3px; }
  .cgrid i { width: 8px; height: 8px; border-radius: 2px; background: rgba(74, 222, 128, 0.75); }
  .cgrid :global(i.e) { background: #1c1c22; }
  .cgrid :global(i.k) { background: var(--g2); box-shadow: 0 0 8px var(--g2); }
  .cmeter { position: absolute; right: 12px; bottom: 12px; display: grid; gap: 3px; text-align: right; }
  .cmeter b { color: var(--tx); font-weight: 500; }
  .cmeter .z b { color: var(--ok); font-size: 15px; }

  .frows { position: absolute; inset: 30px 12px 12px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 7px; align-content: start; }
  .frow { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; background: rgba(255, 255, 255, 0.025); border: 1px solid var(--ln); opacity: 0.25; transition: opacity 0.3s; }
  .frow:global(.on) { opacity: 1; }
  .frow span:first-child { flex: 1; min-width: 0; color: var(--tx); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .v { font-size: 10.5px; padding: 2px 7px; border-radius: 999px; white-space: nowrap; }
  .v:global(.chk) { color: var(--mu); border: 1px dashed var(--ln2); background: none; }
  .v:global(.yes) { color: #06210f; background: var(--ok); }
  .v:global(.no) { color: var(--warn); border: 1px solid rgba(251, 191, 36, 0.5); }

  .hpipe { position: absolute; left: 14px; right: 14px; top: 52px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .hnode { padding: 10px 6px; border-radius: 10px; border: 1px solid var(--ln); background: rgba(255, 255, 255, 0.025); text-align: center; color: var(--mu); transition: border-color 0.3s, color 0.3s, opacity 0.3s; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hnode:global(.on) { border-color: var(--g1); color: var(--tx); }
  .hnode:global(.skip) { opacity: 0.3; text-decoration: line-through; }
  .hdot { position: absolute; top: 44px; left: 14px; width: 10px; height: 10px; border-radius: 50%; background: var(--g2); box-shadow: 0 0 12px var(--g2); transition: left 0.5s var(--ease); }
  .hout { position: absolute; left: 14px; right: 14px; bottom: 14px; display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .dec { font-weight: 500; padding: 5px 10px; border-radius: 8px; border: 1px solid var(--ln2); color: var(--tx); }
  .dec:global(.approve) { border-color: rgba(74, 222, 128, 0.6); color: var(--ok); }
  .dec:global(.review) { border-color: rgba(251, 191, 36, 0.6); color: var(--warn); }
  .dec:global(.reject) { border-color: rgba(248, 113, 113, 0.6); color: var(--bad); }
  .why { color: var(--dim); font-size: 11px; text-align: right; }

  .vcode { position: absolute; left: 12px; top: 28px; right: 150px; margin: 0; font: 11px/1.6 var(--f-mono); color: #8b8b95; white-space: pre; overflow: hidden; }
  .ln { height: 17.6px; }
  .hl { width: fit-content; max-width: 100%; background: rgba(248, 113, 113, 0.14); color: #f4c7c7; border-radius: 3px; }
  .vscan { position: absolute; left: 0; right: 140px; height: 2px; top: 28px; opacity: 0; background: linear-gradient(90deg, transparent, var(--g1), transparent); box-shadow: 0 0 14px var(--g1); }
  .vfind { position: absolute; right: 10px; top: 28px; width: 130px; display: grid; gap: 6px; }
  .vfind div { padding: 6px 8px; border-radius: 8px; border: 1px solid var(--ln); background: rgba(255, 255, 255, 0.03); font-size: 10.5px; line-height: 1.3; opacity: 0; transform: translateX(8px); transition: opacity 0.3s, transform 0.3s var(--ease); }
  .vfind div:global(.on) { opacity: 1; transform: none; }
  .vfind b { display: block; font-weight: 500; }
  .vfind .hi b { color: var(--bad); }
  .vfind .md b { color: var(--warn); }
  .vgrade { position: absolute; right: 12px; bottom: 10px; font: 600 13px var(--f-mono); color: var(--mu); }
  .vgrade b { color: var(--bad); font-size: 20px; margin-left: 6px; }

  .gpipe { position: absolute; left: 14px; right: 14px; top: 38px; display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1.2fr); gap: 10px; align-items: center; }
  .gprov { display: grid; gap: 8px; }
  .gnode { padding: 9px 6px; border-radius: 10px; border: 1px solid var(--ln); background: rgba(255, 255, 255, 0.025); text-align: center; color: var(--mu); transition: border-color 0.3s, color 0.3s, opacity 0.3s; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gnode small { display: block; margin-top: 1px; font-size: 10px; color: var(--dim); }
  .gnode:global(.on) { border-color: var(--g1); color: var(--tx); }
  .gnode:global(.ok) { border-color: rgba(74, 222, 128, 0.6); color: var(--ok); }
  .gnode:global(.bad) { border-color: rgba(248, 113, 113, 0.6); color: var(--bad); }
  .gnode:global(.skip) { border-style: dashed; opacity: 0.55; }
  .gnode:global(.idle) { opacity: 0.4; }
  .gout { position: absolute; left: 14px; right: 14px; bottom: 12px; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .gstate { color: var(--dim); font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gcount { white-space: nowrap; }
  .gcount b { color: var(--ok); font-weight: 500; font-size: 15px; }

  @media (max-width: 460px) {
    .cgrid { grid-template-columns: repeat(25, 6px); gap: 2px; }
    .cgrid i { width: 6px; height: 6px; }
    .vcode { right: 12px; }
    .vfind { display: none; }
  }
</style>

<script>
  // One loop drives every demo on the page. The markup above is the finished
  // state, so with reduced motion (or no JS) each card simply shows its result.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const demos = Array.from(document.querySelectorAll<HTMLElement>('[data-demo]'));

  if (demos.length && !reduce) {
    const visible = new Set<HTMLElement>();
    const io = new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? visible.add(e.target as HTMLElement) : visible.delete(e.target as HTMLElement))), { rootMargin: '80px' });
    demos.forEach((d) => io.observe(d));

    // --- chaos grid: 500 runs fill up, ~87% of them see a worker killed, none are lost
    let seed = 7;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const killSet = Array.from({ length: 500 }, () => rnd() < 0.87);
    const prefix = [0];
    killSet.forEach((k, i) => prefix.push(prefix[i] + (k ? 1 : 0)));
    const chaosState = new WeakMap<HTMLElement, number>();
    const chaos = (el: HTMLElement, t: number) => {
      const cells = el.querySelectorAll<HTMLElement>('.cgrid i');
      const cyc = t % 13, filled = Math.min(500, Math.floor((Math.max(0, cyc - 0.5) / 10) * 500));
      let last = chaosState.get(el) ?? -1;
      if (last < 0 || filled < last) { cells.forEach((c) => (c.className = 'e')); last = 0; }
      for (let i = last; i < filled; i++) cells[i].className = '';
      for (let j = Math.max(0, filled - 8); j < filled; j++) if (killSet[j]) cells[j].className = 'k';
      for (let m = Math.max(0, last - 8); m < Math.max(0, filled - 8); m++) cells[m].className = '';
      chaosState.set(el, filled);
      el.querySelector('[data-d="runs"]')!.textContent = String(filled);
      el.querySelector('[data-d="kills"]')!.textContent = String(Math.round((prefix[filled] * 435) / prefix[500]));
    };

    // --- FitCheck: rows are checked one by one
    const fit = (el: HTMLElement, t: number) => {
      const cyc = t % 10;
      el.querySelectorAll<HTMLElement>('.frow').forEach((r, i) => {
        const start = 0.6 + i * 1.7, v = r.querySelector<HTMLElement>('.v')!;
        const yes = r.dataset.r === 'yes';
        if (cyc < start) { r.classList.remove('on'); v.className = 'v chk'; v.textContent = 'checking…'; }
        else if (cyc < start + 0.9) { r.classList.add('on'); v.className = 'v chk'; v.textContent = 'checking…'; }
        else { r.classList.add('on'); v.className = `v ${yes ? 'yes' : 'no'}`; v.textContent = yes ? 'verified · cited code' : 'unverified · no code'; }
      });
    };

    // --- Health claim: three claims, the AI is skipped whenever a rule decides
    const CASES = [
      { path: [0, 1, 2, 3], dec: 'APPROVE', cls: 'approve', why: 'rules allow, AI agrees' },
      { path: [0, 1, 3], dec: 'HUMAN_REVIEW', cls: 'review', why: 'a rule says review · AI skipped' },
      { path: [0, 1, 3], dec: 'REJECT', cls: 'reject', why: 'a reject rule fired · AI skipped' },
    ];
    const health = (el: HTMLElement, t: number) => {
      const cyc = t % 9.6, ci = Math.min(2, Math.floor(cyc / 3.2)), local = cyc - ci * 3.2, cs = CASES[ci];
      const stepI = Math.min(cs.path.length - 1, Math.floor(local / 0.6)), node = cs.path[stepI];
      const nodes = el.querySelectorAll<HTMLElement>('.hnode');
      nodes.forEach((n, i) => { n.className = 'hnode' + (cs.path.indexOf(i) < 0 ? ' skip' : cs.path.indexOf(i) <= stepI ? ' on' : ''); });
      const pipe = el.querySelector<HTMLElement>('.hpipe')!.getBoundingClientRect(), nb = nodes[node].getBoundingClientRect();
      if (pipe.width) el.querySelector<HTMLElement>('.hdot')!.style.left = `${14 + (nb.left - pipe.left) + nb.width / 2 - 5}px`;
      const dec = el.querySelector<HTMLElement>('.dec')!, why = el.querySelector<HTMLElement>('.why')!;
      if (stepI === cs.path.length - 1) { dec.className = `dec ${cs.cls}`; dec.textContent = cs.dec; why.textContent = cs.why; }
      else { dec.className = 'dec'; dec.textContent = 'deciding…'; why.textContent = ''; }
    };

    // --- VibeAudit: a scan line passes over the code and flags findings
    const vibe = (el: HTMLElement, t: number) => {
      const cyc = t % 8, prog = Math.min(1, cyc / 5.5), lineH = 17.6, lines = 9;
      const scan = el.querySelector<HTMLElement>('.vscan')!;
      scan.style.top = `${28 + prog * lines * lineH}px`;
      scan.style.opacity = prog >= 1 ? '0' : '1';
      el.querySelectorAll<HTMLElement>('.vfind div').forEach((f) => f.classList.toggle('on', prog * lines > Number(f.dataset.f) + 0.6));
      el.querySelector('.vgrade b')!.textContent = prog >= 1 ? 'F' : '';
    };

    // --- LLM Gateway: normal, then the first provider fails, then its circuit opens
    const PHASES = [
      { p: ['ok', 'idle'], notes: ['answered', 'standby'], state: 'normal: provider 1 answers' },
      { p: ['bad', 'ok'], notes: ['failed', 'answered'], state: 'provider 1 down: retry, then backup' },
      { p: ['skip', 'ok'], notes: ['circuit open', 'answered'], state: 'provider 1 skipped, no time wasted' },
    ];
    const gateway = (el: HTMLElement, t: number) => {
      const ph = PHASES[Math.floor((t % 9) / 3)];
      el.querySelectorAll<HTMLElement>('[data-p]').forEach((n, i) => {
        n.className = `gnode ${ph.p[i]}`;
        n.querySelector('small')!.textContent = ph.notes[i];
      });
      el.querySelector('.gstate')!.textContent = ph.state;
    };

    const run: Record<string, (el: HTMLElement, t: number) => void> = { chaos, fit, health, vibe, gateway };
    const t0 = performance.now();
    const loop = (now: number) => {
      requestAnimationFrame(loop);
      const t = Math.max(0, (now - t0) / 1000);
      visible.forEach((el) => { try { run[el.dataset.demo!]?.(el, t); } catch (err) { console.error(err); } });
    };
    requestAnimationFrame(loop);
  }
</script>
