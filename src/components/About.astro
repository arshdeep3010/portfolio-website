---
import { site, experience, education, publication, certifications } from '../data/site';
---
<section id="about" class="section container" aria-labelledby="about-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">About</p>
      <h2 id="about-title">Where I've worked and learned.</h2>
    </div>
  </div>
  <div class="grid">
    <article class="big">
      <p class="k">Experience · {experience.when}</p>
      <h3>{experience.what}</h3>
      <p class="sub">At {site.employer} · {experience.where}</p>
      <ul>{experience.bullets.map((b) => <li>{b}</li>)}</ul>
    </article>
    <article>
      <p class="k">Education · {education.when}</p>
      <h3>{education.degree}</h3>
      <p class="sub">{education.school}</p>
    </article>
    <article>
      <p class="k">Publication</p>
      <h3><a href={publication.href} target="_blank" rel="noopener">{publication.title} <span aria-hidden="true">↗</span></a></h3>
      <p class="sub">{publication.venue}</p>
    </article>
    <article>
      <p class="k">Certifications</p>
      <ul class="plain">{certifications.map((c) => <li>{c}</li>)}</ul>
    </article>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  article { padding: 24px; border-radius: 18px; border: 1px solid var(--ln); background: var(--s1); display: grid; gap: 6px; align-content: start; }
  .big { grid-column: 1 / -1; }
  .k { margin: 0; font: 500 12px var(--f-mono); color: var(--dim); letter-spacing: 0.04em; }
  h3 { margin: 0; font-size: 19px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--g1); }
  .sub { margin: 0; color: var(--mu); font-size: 14.5px; }
  ul { margin: 8px 0 0; padding-left: 18px; color: var(--mu); display: grid; gap: 4px; }
  ul.plain { list-style: none; padding: 0; margin-top: 4px; color: var(--tx); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
