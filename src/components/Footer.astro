---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="container foot">
  <span>© {year} {site.name}</span>
  <span>Built with Astro. Hosted on AWS S3 and CloudFront, set up with Terraform and deployed by GitHub Actions.</span>
</footer>

<style>
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding-top: 72px; padding-bottom: max(40px, env(safe-area-inset-bottom, 0px)); font-size: 13px; color: var(--dim); }
</style>
